{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "class-relay": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Class AI Relay",
      "options": {
        "baseURL": "http://127.0.0.1:4141/v1",
        "apiKey": "placeholder",
        "reasoningEffort": "none"
      },
      "models": {
        "coding": {
          "name": "Class AI Coding"
        }
      }
    }
  },
  "model": "class-relay/coding",
  "mcp": {
    "ddg-search": {
      "type": "local",
      "command": [
        "uvx",
        "duckduckgo-mcp-server"
      ],
      "enabled": true
    }
  }
}