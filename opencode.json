{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode-relay": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode via Relay",
      "options": {
        "baseURL": "http://127.0.0.1:4141/zen/go/v1",
        "apiKey": "placeholder"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        }
      }
    }
  },
  "model": "opencode-relay/deepseek-v4-flash",
  "mcp": {
    "ddg-search": {
      "type": "local",
      "command": ["uvx", "duckduckgo-mcp-server"],
      "enabled": true
    }
  }
}