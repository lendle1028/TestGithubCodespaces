{
	"name": "Python 3 & Node",
	"image": "mcr.microsoft.com/devcontainers/python:3",

	"postCreateCommand": "npm install -g opencode-ai@latest && pip install uv && echo 'export PATH=\"$HOME/.local/bin:$PATH\"' >> ~/.bashrc",
	
	// 改用 postAttachCommand 確保連線時執行，並用背景模式跑腳本
	// "postAttachCommand": "bash .devcontainer/start-opencode.sh && gh codespace ports visibility 4096:public -c \"$CODESPACE_NAME\"",
	
	// "forwardPorts": [4096],
	// "portsAttributes": {
	// 	"4096": {
	// 		"label": "OpenCode Web",
	// 		"onAutoForward": "openBrowser",
	// 		"visibility": "public"
	// 	}
	// },
	"postAttachCommand": "bash .devcontainer/start-relay.sh",
	"remoteEnv": {
		"GO_API_KEY": "${localEnv:GO_API_KEY}",
		"RELAY_PORT": "4141"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"sst-dev.opencode",
				"ms-python.python",
				"zgy.opencode-vscode-ui"
			]
		}
	},
	"features": {
		"ghcr.io/devcontainers/features/node:2": {
			"version": "latest",
			"nodeGypDependencies": true
		},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	}
}